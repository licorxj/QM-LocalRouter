{
  "id": "example-hello",
  "name": "示例插件",
  "description": "演示元信息、设置项(ctx.settings)、写日志、查询数据库（需授权）。",
  "version": "1.1.0",
  "entry": "main.py",
  "function": "run",
  "permissions": ["database.read"],
  "settings": [
    {
      "key": "greeting",
      "type": "string",
      "label": { "zh": "问候语", "en": "Greeting" },
      "description": { "zh": "执行时输出到日志的问候内容", "en": "Text written to the log on run" },
      "default": "你好，插件世界",
      "required": true
    },
    {
      "key": "mode",
      "type": "select",
      "label": { "zh": "运行模式", "en": "Mode" },
      "default": "brief",
      "options": [
        { "value": "brief", "label": { "zh": "简要", "en": "Brief" } },
        { "value": "full", "label": { "zh": "完整", "en": "Full" } }
      ]
    },
    {
      "key": "table_limit",
      "type": "integer",
      "label": { "zh": "数据表列表上限", "en": "Table list limit" },
      "default": 20,
      "min": 1,
      "max": 200
    },
    {
      "key": "verbose",
      "type": "boolean",
      "label": { "zh": "详细日志", "en": "Verbose log" },
      "default": false
    }
  ]
}
